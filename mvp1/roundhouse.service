# Roundhouse unit — enable-based install flow (MVP4)
#
# Operator: copy this file to ~/.config/systemd/user/ and adjust ExecStart:
#
#   cp /path/to/mvp1/roundhouse.service ~/.config/systemd/user/
#   # Edit ExecStart to add --actuate and --port as desired:
#   # ExecStart=/usr/bin/python3 /path/to/mvp1/roundhouse.py --serve --actuate --port 8090
#   systemctl --user daemon-reload && systemctl --user enable --now roundhouse.service
#
# Note: boot-time start requires:
#   loginctl enable-linger $USER
#
# Token file location (after startup):
#   ~/.config/roundhouse/token

[Unit]
Description=Roundhouse — read-only roster server for llama-server fleet
Documentation=https://docs.boltzmann.local/roundhouse
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/roundhouse/roundhouse/mvp1/roundhouse.py --serve
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
